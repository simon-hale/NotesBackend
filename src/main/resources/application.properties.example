spring.application.name=set-name
server.port=${SERVER_PORT}
spring.datasource.username=${DB_USERNAME}
spring.datasource.password=${DB_PASSWORD}
spring.datasource.url=jdbc:mysql://localhost:3306/your-db?serverTimezone=Asia/Shanghai&useUnicode=true&characterEncoding=utf-8
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

mybatis-plus.global-config.field-strategy=IGNORED

# ?????? / RAM ?? AK???????
aliyun.access-key-id=${ALIYUN_ACCESS_KEY_ID}
aliyun.access-key-secret=${ALIYUN_ACCESS_KEY_SECRET}

# STS ?? ARN
aliyun.role-arn=xxx:xxx::xxxxxxxxxxx:xxxx/xxxxxx(your-ram-user)

# STS ?? Region??? OSS ? region?
aliyun.region-id=your-oss-region-id

# OSS ????
aliyun.oss.bucket=your-oss-bucket-name
aliyun.oss.region=your-oss-region
aliyun.oss.domain=your-oss-domain

# JWT
jwt.key=${JWT_KEY}

# Browser authentication / CORS

# Comma-separated exact frontend origins.
# Do not use "*".
app.cors.allowed-origins=${CORS_ALLOWED_ORIGINS:http://localhost:8080}

# Production HTTPS: true.
# Local HTTP development: false.
app.auth.cookie-secure=${AUTH_COOKIE_SECURE:true}

# Same-site frontend/backend: Strict.
# Truly cross-site frontend/backend: None + Secure=true.
app.auth.cookie-same-site=${AUTH_COOKIE_SAME_SITE:Strict}
